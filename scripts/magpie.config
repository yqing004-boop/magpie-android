#!/system/bin/sh
# Magpie 模块配置
# 修改后重启服务生效:
#   su -c "sh /data/adb/modules/magpie/scripts/magpie.service restart"

# 数据目录 (二进制 / 日志 / magpie 自身数据都在这里)
magpie_path="/data/adb/magpie"

# API 网关监听地址
# 0.0.0.0 表示同时监听局域网, 同一 WiFi 下其它设备也能访问
MAGPIE_ADDR="0.0.0.0:3425"

# 网页界面 (WebUI) 监听地址
# magpie serve --web 会在这个地址提供网页; 留空则自动用 MAGPIE_ADDR 的 host + 3430
# MAGPIE_WEB_ADDR="0.0.0.0:3430"

# 上游 DNS 服务器 (空格分隔)
# magpie 是静态编译的 Go 程序, 在 Android 上没有 /etc/resolv.conf,
# 会退回 ::1:53。本模块通过 Go 官方的 DNS_LOCAL_HOSTNAMES 把它指向这里,
# 让 magpie 直接查询这些公网 DNS —— 不监听任何本地端口, 因此不会与
# 系统热点(tethering)抢 53 端口。如果你所在网络访问不了这些地址, 换成自己的。
MAGPIE_DNS="223.5.5.5 119.29.29.29 8.8.8.8"
