<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 平台主题：整个 App 就是一个 WebView + 几张自绘的 M3 卡片，
         不引 Material 组件库；配色令牌全部在 M3.java 里按 TonalSpot 生成，
         这里只负责「首帧别闪白」和系统栏图标颜色。 -->
    <style name="Theme.Magpie" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <!-- 沉浸：状态栏和导航栏都透明，内容铺到屏幕边（代码里还会再设一遍，
             因为用户可能换种子色或深色模式）。 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- 平台控件（开关、ProgressBar）的默认强调色：陶土主色 40 号色调 -->
        <item name="android:colorAccent">#8B4F38</item>
        <item name="android:colorControlActivated">#8B4F38</item>
    </style>

    <!-- 底部弹层：从底下顶上来，宽度拉满。必须是 floating，否则 Dialog 会变成一个
         全屏窗口，gravity 设不动，内容会跑到屏幕顶上。底色由代码按令牌画。 -->
    <style name="Theme.Magpie.Sheet" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:windowMinWidthMajor">100%</item>
        <item name="android:windowMinWidthMinor">100%</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
