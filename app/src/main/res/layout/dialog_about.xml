<?xml version="1.0" encoding="utf-8"?>
<!-- M3 basic dialog：28dp 圆角容器、24sp 标题、14sp 正文，链接行走 primary。
     颜色由 MainActivity.showAbout() 按令牌刷。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/about_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="24dp"
    android:paddingEnd="24dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/about_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/about_app"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/about_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/about_upstream_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/about_upstream"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/about_repo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/about_repo_url"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/about_author_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/about_author"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/about_author_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:text="@string/about_author_name_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/about_author_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:text="@string/about_author_url_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/about_license_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/about_license_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/about_notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="?android:attr/selectableItemBackground"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:text="@string/about_notice"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/about_ai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/about_ai"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/about_unofficial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/about_unofficial"
        android:textSize="12sp" />
</LinearLayout>
