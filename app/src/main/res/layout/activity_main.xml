<?xml version="1.0" encoding="utf-8"?>
<!-- 顶栏卡片 + 圆角内容区 + 启动/失败遮罩。
     沉浸：根布局不设 fitsSystemWindows，状态栏那一条由 shell 的 paddingTop
     自己让出来（代码里算的 status_bar_height），卡片就不会钻进状态栏。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F4F8">

    <LinearLayout
        android:id="@+id/shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 顶栏：一只鸟 + 名字 + 状态点 + 网关胶囊 + 三个点。 -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="8dp">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magpie_bird" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textColor="#2A2320"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/state_dot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/dot_off" />

                    <TextView
                        android:id="@+id/state_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="@string/header_starting"
                        android:textColor="#6B625D"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 点一下就复制 http://127.0.0.1:3425/v1 -->
            <TextView
                android:id="@+id/gw_pill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:clickable="true"
                android:focusable="true"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:text="@string/header_gateway_placeholder"
                android:textColor="#8A4B32"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sheet_title"
                android:gravity="center"
                android:text="&#8942;"
                android:textColor="#5A514C"
                android:textSize="18sp" />
        </LinearLayout>

        <!-- 内容区：四角圆弧，里面是 magpie 的 Web UI（圆角由代码 clipToOutline 裁）。 -->
        <FrameLayout
            android:id="@+id/web_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_content">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- 网关还没起来、或者挂了的时候顶上来。 -->
    <ScrollView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4F4F8"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/status_starting"
                android:textColor="#1C1C1E"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="#4A4A52"
                android:textSize="13sp" />

            <Button
                android:id="@+id/status_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/status_retry" />

            <Button
                android:id="@+id/status_show_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:text="@string/status_show_log" />

            <Button
                android:id="@+id/status_settings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_settings" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
