<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 骨架：顶栏（surface container）、圆角内容区（surface container lowest）、
     网关未就绪时的整页状态。颜色全部在 MainActivity.applyTheme() 里按 M3 令牌刷，
     XML 只定结构和尺寸。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/shell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- M3 top app bar：56dp 高，圆角大卡片，图标按钮 48dp -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="12dp"
            android:gravity="center_vertical"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:id="@+id/avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_magpie_bird" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/header_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0"
                    android:text="@string/app_name"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/state_dot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/dot_off" />

                    <TextView
                        android:id="@+id/state_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/header_starting"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- 本机网关地址：点一下复制 http://127.0.0.1:3425/v1 -->
            <TextView
                android:id="@+id/gw_pill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/header_gateway_placeholder"
                android:textSize="12sp" />

            <!-- 小入口：不占 IP 地址宽度，点击才展示局域网地址和密钥 -->
            <TextView
                android:id="@+id/lan_pill"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/lan_pill_off"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/menu"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sheet_title"
                android:gravity="center"
                android:text="&#8942;"
                android:textSize="20sp" />
        </LinearLayout>

        <!-- 内容区：24dp 圆弧，里面是 magpie 的 Web UI（圆角由代码 clipToOutline 裁） -->
        <FrameLayout
            android:id="@+id/web_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="10dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>
    </LinearLayout>

    <!-- 网关还没起来、或者挂了的时候顶上来。 -->
    <ScrollView
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="28dp">

            <TextView
                android:id="@+id/status_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/status_starting"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="3dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/status_retry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:minWidth="160dp"
                android:text="@string/status_retry" />

            <Button
                android:id="@+id/status_show_log"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginBottom="10dp"
                android:minWidth="160dp"
                android:text="@string/status_show_log" />

            <Button
                android:id="@+id/status_settings"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:minWidth="160dp"
                android:text="@string/status_settings" />
        </LinearLayout>
    </ScrollView>

</FrameLayout>
