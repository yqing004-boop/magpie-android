<?xml version="1.0" encoding="utf-8"?>
<!-- M3 设置页：五张 tonal 卡片 + 两个按钮。卡片底色、描边、文字色都在
     SettingsActivity.applyTheme() 里按令牌刷。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/settings_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginBottom="14dp"
            android:text="@string/act_settings"
            android:textSize="26sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/card_port"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/label_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_gateway_port"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hint_port"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_gateway_port_hint"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/port"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:inputType="number"
                android:maxLength="5"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_lan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <Switch
                android:id="@+id/lan"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/settings_lan"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hint_lan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_lan_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_background"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/label_web_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_web_memory"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hint_web_memory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_web_memory_hint"
                android:textSize="12sp" />

            <RadioGroup
                android:id="@+id/web_release_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/web_release_never"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/settings_web_never" />

                <RadioButton
                    android:id="@+id/web_release_15"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/settings_web_15" />

                <RadioButton
                    android:id="@+id/web_release_30"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/settings_web_30" />

                <RadioButton
                    android:id="@+id/web_release_custom"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="@string/settings_web_custom" />
            </RadioGroup>

            <EditText
                android:id="@+id/web_release_custom_minutes"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:gravity="center_vertical"
                android:hint="@string/settings_web_custom_hint"
                android:inputType="number"
                android:maxLength="4"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_background_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/label_background_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_background_guide"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hint_background_guide"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_background_guide_hint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/open_notification_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/settings_open_notifications" />

            <Button
                android:id="@+id/open_battery_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/settings_open_battery" />

            <Button
                android:id="@+id/open_background_guide"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/settings_open_background_guide" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_feed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/label_feed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_update_feed"
                android:textSize="15sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/feed"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:inputType="textUri"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textSize="14sp" />

            <Switch
                android:id="@+id/stable_channel"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:text="@string/settings_stable_channel"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/hint_stable_channel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_stable_channel_hint"
                android:textSize="12sp" />

            <Button
                android:id="@+id/check_update"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="@string/settings_check_update" />

            <Button
                android:id="@+id/check_shell"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:text="@string/settings_check_shell" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_appearance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <Switch
                android:id="@+id/monet"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="@string/settings_monet"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/monet_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_monet_hint"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/card_seed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/label_seed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_seed"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/hint_seed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_seed_hint"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/colors_seed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:text="@string/settings_save" />

        <Button
            android:id="@+id/restart"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="10dp"
            android:text="@string/settings_restart_now" />

    </LinearLayout>
</ScrollView>
